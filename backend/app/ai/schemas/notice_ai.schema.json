{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM 이 돌려주는 공지 분석 결과 (status 는 코드가 붙인다)",
  "type": "object",
  "required": [
    "categories",
    "tags",
    "summary",
    "deadline",
    "audience",
    "apply"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "deadline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "date",
            "time",
            "evidence"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "time": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}$"
                }
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "audience": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "years": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "majors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "apply": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
